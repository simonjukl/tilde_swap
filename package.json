{
  "name": "tilde-swap",
  "displayName": "tilde-swap",
  "publisher": "simonjukl",
  "description": "Swap sides of R formula expressions",
  "version": "0.0.7",
  "engines": {
    "vscode": ">=1.109.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simon-jukl/tilde_swap"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:r",
    "onLanguage:quarto"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tilde-swap.swapFormula",
        "title": "Swap Formula Sides (~)",
        "category": "Tilde Swap"
      }
    ],
    "keybindings": [
      {
        "command": "tilde-swap.swapFormula",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && (editorLangId == r || editorLangId == quarto)"
      }
    ],
    "configuration": {
      "title": "Tilde Swap",
      "properties": {
        "tilde-swap.multiline": {
          "type": "boolean",
          "default": true,
          "description": "Allow swapping formulas across multiple selected lines."
        },
        "tilde-swap.languages": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["r", "quarto"],
          "description": "Language IDs in which the swap command and keybinding are active."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "tilde-swap.swapFormula",
          "when": "editorLangId == r || editorLangId == quarto",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/swap.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
